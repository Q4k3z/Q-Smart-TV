# Cấu hình Q Smart TV
QSMART_HOST=0.0.0.0
QSMART_PORT=8765

# Token xác thực (Nếu để trống, hệ thống sẽ tự động tạo chuỗi ngẫu nhiên bảo mật tại data/config/auth_token.txt)
# QSMART_AUTH_TOKEN=your_custom_secure_token_here

# Đường dẫn Brave Browser (Nếu để trống, hệ thống sẽ tự động tìm kiếm trên Windows)
# QSMART_BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Đường dẫn mpv Player (Nếu để trống, hệ thống sẽ tự động tìm kiếm trên Windows)
# QSMART_MPV_PATH=C:\Program Files\MPV Player\mpv.exe
