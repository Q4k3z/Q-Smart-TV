# Cấu hình Q Smart TV
QSMART_HOST=0.0.0.0
QSMART_PORT=8765
# Tùy chọn: IP Ethernet/Wi-Fi thật; bỏ trống để tự chọn, loại mạng VPN.
# QSMART_LAN_IP=192.168.1.3

# Token xác thực (bỏ trống để tạo bí mật riêng tại data/config/pairing_token.txt, không đưa lên Git)
# QSMART_AUTH_TOKEN=your_custom_secure_token_here

# Đường dẫn Brave Browser (Nếu để trống, hệ thống sẽ tự động tìm kiếm trên Windows)
# QSMART_BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Đường dẫn mpv Player (Nếu để trống, hệ thống sẽ tự động tìm kiếm trên Windows)
# QSMART_MPV_PATH=C:\Program Files\MPV Player\mpv.exe

# Chỉ quét thư mục data/media và các thư mục bạn cho phép bên dưới (JSON, dùng / trên Windows):
# QSMART_ALLOWED_MEDIA_DIRS=["D:/Phim", "E:/Video gia đình"]
